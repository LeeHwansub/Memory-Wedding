# ── Database ──
MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=memory_wedding
MYSQL_USER=memory
MYSQL_PASSWORD=memory

# ── Frontend ──
NEXT_PUBLIC_API_URL=http://localhost:8080
FRONTEND_URL=http://localhost:3000
# Kakao Map JavaScript 키 (developers.kakao.com → 앱 키 → JavaScript 키)
# Web 플랫폼에 http://localhost:3000 도메인 등록 필요
NEXT_PUBLIC_KAKAO_MAP_APP_KEY=

# ── Backend JWT ──
JWT_SECRET=change-me-in-production-use-long-random-string

# ── Google OAuth (로그인 + Drive 사본, 동일 클라이언트) ──
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Drive OAuth 콜백 — Cloud Console 승인된 리디렉션 URI에 등록
DRIVE_REDIRECT_URI=http://localhost:8080/api/drive/oauth/callback

# ── Naver OAuth ──
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# ── Kakao OAuth ──
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=

# ── Upload storage (원본 백업) ──
# local | gcs  — Drive 사본 전달은 이후 feat/google-drive
STORAGE_TYPE=local
STORAGE_LOCAL_PATH=./data/uploads
GCS_BUCKET=
# Docker에서 GCS 쓸 때:
#   1) secrets/ 에 SA JSON 복사 (gitignore됨)
#   2) GCS_CREDENTIALS_PATH 는 컨테이너 경로(/secrets/...)
GCS_CREDENTIALS_HOST_PATH=./secrets
GCS_CREDENTIALS_PATH=/secrets/gcs-sa.json

# ── Gemini AI (비우면 mock 휴리스틱 분류) ──
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_MAX_PHOTOS=20
# 이 값 미만 confidence 사진은 장면 분류·Best Shot에서 제외 (원본 Photos/ 유지)
GEMINI_MIN_CONFIDENCE=0.60
GEMINI_MAX_VIDEOS=5
GEMINI_VIDEO_FRAMES=5
